# Existing PostgreSQL database used for persistent game data.
DATABASE_URL=postgres://username:password@localhost:5432/frontier_echoes
REDIS_URL=redis://127.0.0.1:6379

# UDP game server settings.
GAME_SERVER_ADDR=127.0.0.1:4000
GAME_TICK_HZ=60
GAME_CHARACTER_NAME=local-player
GAME_ASSET_ADDR=127.0.0.1:4100
GAME_API_ADDR=127.0.0.1:8080

# Reserved for the database persistence layer.
DATABASE_MAX_CONNECTIONS=5

# Optional OTLP gRPC endpoint. Leave unset to use local stdout logging only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=frontier-server
